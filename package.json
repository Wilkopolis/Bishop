{
  "name": "bishop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "dotnet run --project desktop-host/Bishop.csproj -- --api-only",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:standalone": "npm run build && dotnet build desktop-host/Bishop.csproj -c Release -o ./release",
    "desktop": "npm run build:standalone && .\\release\\Bishop.exe",
    "publish:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
